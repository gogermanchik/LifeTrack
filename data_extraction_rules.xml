@Composable
fun LifeProgressBar(value: Long, target: Long, color: Color = MaterialTheme.colorScheme.primary) {
    val p = if (target <= 0) 0f else percent(value, target).coerceIn(0, 100) / 100f
    val animated by animateFloatAsState(p, tween(200), label = "progress")
    Box(
        Modifier.fillMaxWidth().height(5.dp).clip(CircleShape).background(color.copy(alpha = .12f))
    ) {
        Box(Modifier.fillMaxWidth(animated).fillMaxHeight().clip(CircleShape).background(color))
    }
}

@Composable
fun Progress(value: Long, target: Long) {
    LifeProgressBar(value, target)
}

