@Composable
fun BrandMark(modifier: Modifier = Modifier, color: Color = MaterialTheme.colorScheme.primary) {
    Canvas(modifier.size(32.dp)) {
        val r = size.width * .22f
        drawCircle(
            color,
            r,
            androidx.compose.ui.geometry.Offset(size.width * .32f, size.height * .32f),
        )
        drawCircle(
            color,
            r,
            androidx.compose.ui.geometry.Offset(size.width * .70f, size.height * .32f),
        )
        drawCircle(
            color,
            r,
            androidx.compose.ui.geometry.Offset(size.width * .32f, size.height * .70f),
        )
        drawCircle(
            color.copy(alpha = .4f),
            r,
            androidx.compose.ui.geometry.Offset(size.width * .70f, size.height * .70f),
        )
    }
}

@Composable
fun LifeTopBar(
    title: String,
    subtitle: String = "",
    action: (() -> Unit)? = null,
    actionIcon: ImageVector = Icons.Outlined.Add,
    actionLabel: String = "Добавить",
) {
    Row(Modifier.fillMaxWidth(), verticalAlignment = Alignment.CenterVertically) {
        Column(Modifier.weight(1f)) {
            Text(title, style = MaterialTheme.typography.headlineLarge)
            if (subtitle.isNotBlank())
                Text(
                    subtitle,
                    style = MaterialTheme.typography.bodySmall,
                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                )
        }
        if (action != null) LifeIconButton(actionIcon, actionLabel, action)
    }
}

@Composable
