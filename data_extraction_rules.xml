@Composable
fun LifeInput(
    label: String,
    value: String,
    change: (String) -> Unit,
    numeric: Boolean = false,
    hero: Boolean = false,
) {
    Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
        Text(
            label,
            style = MaterialTheme.typography.bodySmall,
            color = MaterialTheme.colorScheme.onSurfaceVariant,
        )
        BasicTextField(
            value,
            change,
            Modifier.fillMaxWidth()
                .clip(MaterialTheme.shapes.small)
                .background(MaterialTheme.colorScheme.surfaceContainer)
                .padding(horizontal = 14.dp, vertical = 14.dp),
            textStyle =
                (if (hero) MaterialTheme.typography.displaySmall
                    else MaterialTheme.typography.bodyLarge)
                    .copy(color = MaterialTheme.colorScheme.onSurface),
            singleLine = true,
            keyboardOptions =
                KeyboardOptions(
                    keyboardType = if (numeric) KeyboardType.Decimal else KeyboardType.Text
                ),
            cursorBrush = SolidColor(MaterialTheme.colorScheme.primary),
            decorationBox = { inner ->
                Box {
                    if (value.isEmpty())
                        Text(
                            if (numeric) "0" else "Введите значение",
                            color = MaterialTheme.colorScheme.onSurfaceVariant,
                            style =
                                if (hero) MaterialTheme.typography.displaySmall
                                else MaterialTheme.typography.bodyLarge,
                        )
                    inner()
                }
            },
        )
    }
}

@Composable
fun LifeOverflow(actions: List<Pair<String, () -> Unit>>) {
    var show by remember { mutableStateOf(false) }
    Box {
        IconButton({ show = true }, Modifier.size(40.dp)) {
            Icon(
                Icons.Outlined.MoreHoriz,
                "Действия",
                Modifier.size(20.dp),
                tint = MaterialTheme.colorScheme.onSurfaceVariant,
            )
        }
        DropdownMenu(show, { show = false }) {
            actions.forEach { (label, action) ->
                DropdownMenuItem(
                    text = {
                        Text(
                            label,
                            color =
                                if (label.startsWith("Удалить")) lifeColors.expense
                                else MaterialTheme.colorScheme.onSurface,
                        )
                    },
                    onClick = {
                        show = false
                        action()
                    },
                )
            }
        }
    }
}

fun lifeSection(route: String): String =
    when {
        route == "today" -> "today"
        route.startsWith("nutrition") -> "nutrition"
        route.startsWith("habit") -> "habits"
        route.startsWith("finance") ||
            route in
                setOf(
                    "bank-automation",
                    "statement-import",
                    "accounts",
                    "categories",
                    "budgets",
                    "subscriptions",
                    "report",
                ) -> "finance"
        else -> "more"
    }

@Composable
fun LifeNavigationBar(
    tabs: List<Pair<String, String>>,
    selected: String,
    onSelect: (String) -> Unit,
) {
    Column(Modifier.background(MaterialTheme.colorScheme.surface).navigationBarsPadding()) {
        HorizontalDivider(color = MaterialTheme.colorScheme.outlineVariant.copy(alpha = .6f))
        Row(Modifier.fillMaxWidth().padding(horizontal = 8.dp, vertical = 8.dp)) {
            val icons =
                listOf(
                    Icons.Outlined.Home,
                    Icons.Outlined.Restaurant,
                    Icons.Outlined.CheckCircle,
                    Icons.Outlined.AccountBalanceWallet,
                    Icons.Outlined.MoreHoriz,
                )
            tabs.forEachIndexed { i, t ->
                val active = lifeSection(selected) == t.first
                Column(
                    Modifier.weight(1f)
                        .selectable(active, onClick = { onSelect(t.first) }, role = Role.Tab)
                        .padding(vertical = 2.dp),
                    horizontalAlignment = Alignment.CenterHorizontally,
                    verticalArrangement = Arrangement.spacedBy(3.dp),
                ) {
                    Box(
                        Modifier.size(width = 44.dp, height = 30.dp)
                            .clip(CircleShape)
                            .background(
                                if (active) MaterialTheme.colorScheme.primaryContainer
                                else Color.Transparent
                            ),
                        contentAlignment = Alignment.Center,
                    ) {
                        Icon(
                            icons[i],
                            null,
                            Modifier.size(21.dp),
                            tint =
                                if (active) MaterialTheme.colorScheme.primary
                                else MaterialTheme.colorScheme.onSurfaceVariant,
                        )
                    }
                    Text(
                        t.second,
                        style = MaterialTheme.typography.labelSmall,
                        color =
                            if (active) MaterialTheme.colorScheme.primary
                            else MaterialTheme.colorScheme.onSurfaceVariant,
                        maxLines = 1,
                    )
                }
            }
        }
    }
}

