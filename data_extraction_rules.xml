@Composable
fun Choice(label: String, value: String, options: List<String>, select: (String) -> Unit) {
    var show by remember { mutableStateOf(false) }
    LifeSettingRow(label, display(value.substringAfter(": ", value)), onClick = { show = true })
    if (show)
        LifeBottomSheet({ show = false }) {
            Text(label, style = MaterialTheme.typography.headlineSmall)
            options.forEach { n ->
                Row(
                    Modifier.fillMaxWidth()
                        .selectable(
                            n == value,
                            onClick = {
                                select(n)
                                show = false
                            },
                        )
                        .padding(vertical = 14.dp),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Text(
                        display(n.substringAfter(": ", n)),
                        Modifier.weight(1f),
                        style = MaterialTheme.typography.bodyLarge,
                    )
                    if (n == value)
                        Icon(Icons.Outlined.Check, null, tint = MaterialTheme.colorScheme.primary)
                }
            }
        }
}

